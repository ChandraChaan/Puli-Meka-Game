rules_version = '2';

// Online Puli Meka rooms. Every player signs in anonymously. A room is
// readable by anyone signed in (so a code can be joined), but only its two
// players can change it, a move can only be added by the side whose turn
// it is, and moves already played can never be rewritten.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 20;
    }

    function allowedKeys() {
      return ['code', 'hostUid', 'hostName', 'hostSide', 'guestUid', 'guestName',
              'goatUid', 'tigerUid', 'captureTarget', 'moves', 'status', 'result',
              'leftBy', 'isPublic', 'round', 'rematch', 'lastSeen', 'createdAt',
              'updatedAt', 'expireAt'];
    }

    // The move list may stay the same, grow by one move from the player whose
    // turn it is, or be cleared for a rematch once a game is over.
    function movesOk() {
      let before = resource.data.moves;
      let after = request.resource.data.moves;
      let sameRound = request.resource.data.round == resource.data.round;
      let sameSides = request.resource.data.goatUid == resource.data.goatUid
          && request.resource.data.tigerUid == resource.data.tigerUid;
      return (after == before && sameRound && sameSides)
          || (sameRound && sameSides
              && resource.data.status == 'playing'
              && after.size() == before.size() + 1
              // (Slicing an empty range is an error, so skip it for the first move.)
              && (before.size() == 0 || after[0:before.size()] == before)
              && after[before.size()] is string
              && after[before.size()].size() <= 8
              && me() == (before.size() % 2 == 0 ? resource.data.goatUid : resource.data.tigerUid))
          || (after.size() == 0
              && resource.data.status in ['over', 'abandoned']
              && request.resource.data.status == 'playing'
              && request.resource.data.round == resource.data.round + 1
              // Players swap sides each rematch.
              && request.resource.data.goatUid == resource.data.tigerUid
              && request.resource.data.tigerUid == resource.data.goatUid);
    }

    match /rooms/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
          && code.matches('^[A-Z2-9]{6}$')
          && request.resource.data.keys().hasOnly(allowedKeys())
          && request.resource.data.code == code
          && request.resource.data.hostUid == me()
          && validName(request.resource.data.hostName)
          && request.resource.data.hostSide in ['goat', 'tiger']
          && request.resource.data.guestUid == null
          && request.resource.data.captureTarget in [4, 5, 6, 7]
          && request.resource.data.moves == []
          && request.resource.data.status == 'waiting'
          && request.resource.data.round == 0
          && request.resource.data.isPublic is bool;

      // A second player takes the empty seat in a waiting room.
      allow update: if signedIn()
          && resource.data.status == 'waiting'
          && resource.data.guestUid == null
          && resource.data.hostUid != me()
          && request.resource.data.guestUid == me()
          && validName(request.resource.data.guestName)
          && request.resource.data.status == 'playing'
          && changed().hasOnly(['guestUid', 'guestName', 'status', 'goatUid', 'tigerUid',
                                'lastSeen', 'updatedAt', 'expireAt'])
          && request.resource.data.goatUid
              == (resource.data.hostSide == 'goat' ? resource.data.hostUid : me())
          && request.resource.data.tigerUid
              == (resource.data.hostSide == 'goat' ? me() : resource.data.hostUid);

      // The two players play, finish, leave and ask for rematches.
      allow update: if signedIn()
          && resource.data.guestUid != null
          && me() in [resource.data.hostUid, resource.data.guestUid]
          && request.resource.data.keys().hasOnly(allowedKeys())
          && !changed().hasAny(['code', 'hostUid', 'hostName', 'hostSide', 'guestUid',
                                'guestName', 'captureTarget', 'isPublic', 'createdAt'])
          && request.resource.data.status in ['playing', 'over', 'abandoned']
          && movesOk();

      // The host can keep a waiting room alive or cancel it.
      allow update: if signedIn()
          && resource.data.status == 'waiting'
          && resource.data.hostUid == me()
          && changed().hasOnly(['lastSeen', 'updatedAt', 'expireAt']);

      allow delete: if signedIn()
          && resource.data.hostUid == me()
          && resource.data.status == 'waiting';
    }
  }
}
